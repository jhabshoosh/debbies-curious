{
  "install": "npm ci",
  "commands": [
    "npm run lint",
    "npx tsc --noEmit",
    "npm run test:run",
    "npm run build"
  ],
  "spec_test": "npx vitest run",
  "limits": {
    "lead": { "max_turns": 30, "timeout_minutes": 15 },
    "build": { "max_turns": 60, "timeout_minutes": 30 },
    "review": { "max_turns": 15, "timeout_minutes": 10 }
  },
  "frozen_paths": [
    ".github",
    "team",
    ".claude",
    "CLAUDE.md",
    "package*.json",
    "*.config.*",
    "src/test",
    ".gitleaks*",
    ".npmrc",
    ".prettier*",
    "tsconfig*.json",
    "npm-shrinkwrap.json",
    ".gitignore",
    "*/CLAUDE.md",
    "*/.claude",
    ".gitattributes",
    "*/.gitattributes",
    "*/package*.json",
    "*/tsconfig*.json",
    "*/.npmrc",
    ".env*",
    ".mcp.json",
    "CLAUDE.local.md",
    "*/CLAUDE.local.md"
  ],
  "test_paths": ["*.test.*", "*.spec.*", "*__tests__", "e2e"],
  "allowed_paths": ["src/**", "public/**"]
}
