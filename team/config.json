{
  "install": "npm ci",
  "commands": [
    "npm run lint",
    "npx tsc --noEmit",
    "npm run test:run",
    "npm run build"
  ],
  "spec_test": "npx vitest run",
  "agent_settings": {
    "sandbox": {
      "enabled": true,
      "failIfUnavailable": true,
      "allowUnsandboxedCommands": false,
      "autoAllowBashIfSandboxed": false,
      "network": {
        "strictAllowlist": true
      }
    }
  },
  "limits": {
    "lead": {
      "max_turns": 30,
      "timeout_minutes": 15
    },
    "build": {
      "max_turns": 60,
      "timeout_minutes": 30
    },
    "review": {
      "max_turns": 15,
      "timeout_minutes": 10
    },
    "product": {
      "max_turns": 30,
      "timeout_minutes": 10,
      "runs_per_day": 1
    },
    "runs_per_week": 3,
    "blocked_in_a_row": 3,
    "goal_max_bytes": 4000,
    "diff_max_bytes": 200000,
    "diff_max_line": 2000,
    "record_max_bytes": 200000,
    "feedback_max_bytes": 4000,
    "attempts": 4
  },
  "frozen_paths": [
    ".github",
    "team",
    ".claude",
    "CLAUDE.md",
    "package*.json",
    "*.config.*",
    "src/test",
    ".gitleaks*",
    ".npmrc",
    ".prettier*",
    "tsconfig*.json",
    "npm-shrinkwrap.json",
    ".gitignore",
    "*/.gitignore",
    "*/CLAUDE.md",
    "*/.claude",
    ".gitattributes",
    "*/.gitattributes",
    "*/package*.json",
    "*/tsconfig*.json",
    "*/.npmrc",
    ".env*",
    ".mcp.json",
    "CLAUDE.local.md",
    "*/CLAUDE.local.md"
  ],
  "test_paths": ["*.test.*", "*.spec.*", "*__tests__", "e2e"],
  "allowed_paths": ["src/**", "public/**"],
  "gitleaks": {
    "version": "8.30.1",
    "sha256": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
  },
  "sandbox_placeholders": [
    ".env.development",
    ".env.production",
    ".env.test",
    ".gitmodules",
    ".npmrc",
    ".yarnrc",
    ".yarnrc.yml",
    "bunfig.toml",
    "pnpm-lock.yaml",
    "yarn.lock"
  ]
}
